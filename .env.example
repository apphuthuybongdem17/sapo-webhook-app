# === SAPO OMNI (nguồn phôi — Single Source of Truth, đăng ký webhook tại đây) ===
SAPO_OMNI_API_KEY=your_omni_api_key
SAPO_OMNI_API_SECRET=your_omni_api_secret
SAPO_OMNI_STORE_URL=https://your-omni-store.mysapo.net
SAPO_OMNI_WEBHOOK_SECRET=your_omni_api_secret

# === SAPO WEB (đích — cập nhật variant thành phẩm KT_*) ===
SAPO_WEB_API_KEY=your_sapo_web_api_key
SAPO_WEB_API_TOKEN=your_sapo_web_api_key
SAPO_WEB_API_SECRET=your_sapo_web_api_secret
SAPO_WEB_STORE_URL=https://your-sapo-web-store.mysapo.net
SAPO_WEB_LOCATION_ID=123456789

# Webhook HMAC (Sapo Web Private App secret)
SAPO_WEBHOOK_SECRET=your_webhook_secret

# Vercel Cron bảo mật (tự sinh chuỗi ngẫu nhiên)
CRON_SECRET=your_random_cron_secret

# Tuỳ chọn: chỉ poll các phôi cụ thể (phân cách bằng dấu phẩy)
# WATCH_PHOI_SKUS=dtbvc-T-12p,vmln-C-1

# Legacy fallback
SAPO_API_KEY=
SAPO_API_SECRET=
SAPO_STORE_URL=
SAPO_LOCATION_ID=
